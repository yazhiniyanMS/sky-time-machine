# Copy to .env (never commit .env). All values are optional.

# Local cache for FITS cutouts, derived products and the SQLite database
# STM_DATA_DIR=./data
# Any SQLAlchemy URL; default is SQLite in STM_DATA_DIR
# STM_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/stm

# SPHEREx collection queried via IRSA SIA2 (spherex_dr1 = DR1 wide survey)
# STM_SPHEREX_COLLECTION=spherex_dr1

# Sky Intelligence assistant: auto | anthropic | none.
# Without a key the assistant runs in rule-based mode (no LLM).
# ANTHROPIC_API_KEY=
# STM_ASSISTANT_MODEL=claude-opus-5-5

# Shared secret for moderators/reviewers; moderation and verification endpoints are disabled when empty
# STM_MODERATOR_TOKEN=

# Allowed browser origins for the API
# STM_CORS_ORIGINS=http://localhost:3000

# Frontend: backend base URL
# NEXT_PUBLIC_API_URL=http://localhost:8000
